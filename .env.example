# .env.example — copy to .env and fill in. NEVER commit the real .env.
#
# This file is a template and contains no secret. Every value below is read
# from the ENVIRONMENT at startup; none is stored in configs/default.yaml,
# which is why that file is safe to commit and this one is not.

# ---------------------------------------------------------------------------
# REQUIRED — session cookie signing key
# ---------------------------------------------------------------------------
# Signs the session cookie. If unset, the server generates a random ephemeral
# key at startup, warns loudly, and every session is invalidated on restart.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this signs everyone out and invalidates every outstanding CSRF
# token. That is the intended way to force a global logout.
PRODUCT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — PostgreSQL (NOT active in this build)
# ---------------------------------------------------------------------------
# The repository layer speaks portable, parameterised SQL, but Postgres is
# gated off: it needs psycopg2 installed and storage.postgres.enabled set true
# in configs/default.yaml. Until then this value is ignored.
#
# The DSN carries a password, which is exactly why it lives here and never in
# the committed config.
#   PRODUCT_DATABASE_URL=postgresql://als:CHANGE_ME@127.0.0.1:5432/als
PRODUCT_DATABASE_URL=

# ---------------------------------------------------------------------------
# NOTES
# ---------------------------------------------------------------------------
# * There is no API key, token or webhook URL to set. The product has no
#   outbound integrations by design — no alerting webhook, no SIEM forwarder,
#   no email. Adding one would break the containment guarantee that
#   tests/test_containment_outbound.py enforces.
#
# * There is no default administrator password. Accounts exist only because an
#   operator created them:
#       python -m scripts.init_db
#       python -m scripts.create_user --username <name> --role Admin
#
# * File permissions matter more than usual here: this .env grants the ability
#   to forge a session cookie for any user.
#       chmod 600 .env
